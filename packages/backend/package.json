{
  "name": "@bookipi/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Express API and durable sale services.",
  "type": "module",
  "imports": {
    "#types": {
      "development": "./src/types.ts",
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "#app": {
      "development": "./src/app.ts",
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#api/*": {
      "development": "./src/api/*.ts",
      "types": "./src/api/*.ts",
      "default": "./dist/api/*.js"
    },
    "#features/*": {
      "development": "./src/features/*.ts",
      "types": "./src/features/*.ts",
      "default": "./dist/features/*.js"
    },
    "#services/*": {
      "development": "./src/services/*.ts",
      "types": "./src/services/*.ts",
      "default": "./dist/services/*.js"
    }
  },
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "seed": "node --conditions=development --import tsx src/seed.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1138.0",
    "@better-auth/redis-storage": "1.7.5",
    "better-auth": "1.7.5",
    "express": "5.1.0",
    "ioredis": "^5.11.1",
    "mongodb": "^7.6.0",
    "mongoose": "9.10.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
