{
  "name": "@bookipi/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Express API and durable sale services.",
  "type": "module",
  "imports": {
    "#app": {
      "development": "./src/app.ts",
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    },
    "#api/*": {
      "development": "./src/api/*.ts",
      "types": "./src/api/*.ts",
      "default": "./dist/api/*.js"
    }
  },
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "express": "5.1.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
